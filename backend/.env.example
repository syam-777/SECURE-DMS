# Backend environment variables
# Copy this file to .env and fill in your own local values.
# NEVER commit real secrets to .env or this file.

# Server
PORT=5000

# MySQL database connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=secure_dms
DB_PORT=3306

# JWT authentication
# Generate a long random secret locally (e.g. openssl rand -base64 48).
# NEVER commit a real secret here — this is only a placeholder.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
# Frontend CORS origin
FRONTEND_ORIGIN=http://localhost:5173

# Backblaze B2 Cloud Storage (private bucket) for document files.
# Placeholders only — NEVER commit real keys.
# B2_S3_ENDPOINT: B2 S3-compatible endpoint, e.g. https://s3.<region>.backblazeb2.com
# B2_REGION: must match the region in the endpoint, e.g. us-east-005
# B2_BUCKET: secure-dms-files-2026
B2_S3_ENDPOINT=https://s3.region.example.backblazeb2.com
B2_ACCESS_KEY_ID=replace-with-your-b2-access-key-id
B2_SECRET_ACCESS_KEY=replace-with-your-b2-secret-access-key
B2_BUCKET=secure-dms-files-2026
B2_REGION=replace-with-your-b2-region