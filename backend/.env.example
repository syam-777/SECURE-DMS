# Backend environment variables
# Copy this file to .env and fill in your own local values.
# NEVER commit real secrets to .env or this file.

# Server
PORT=5000

# MySQL database connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=secure_dms
DB_PORT=3306

# JWT authentication
# Generate a long random secret locally (e.g. openssl rand -base64 48).
# NEVER commit a real secret here — this is only a placeholder.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
